#!/usr/bin/env bash
# Prove a deliverable builds and runs with no outbound network, the way a grader runs it.
#
#   factory/bin/offline-check <dir> [-- <command to run inside the container>]
#
# <dir> must hold a Dockerfile. The image is built with networking off, so anything the
# build fetches from the internet fails here rather than in front of a judge; vendor or
# lock dependencies instead. The container then runs the command (default: npm test),
# again with no network. Exit status is the command's.
#
# The base image must already be present locally: pull it once while online.
set -euo pipefail

dir=${1:-}
[[ -n "$dir" && -d "$dir" ]] || { sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
shift
[[ "${1:-}" == "--" ]] && shift
cmd=("$@")
[[ ${#cmd[@]} -eq 0 ]] && cmd=(npm test)

[[ -f "$dir/Dockerfile" ]] || { echo "offline-check: no Dockerfile in $dir" >&2; exit 2; }
command -v docker >/dev/null || { echo "offline-check: docker is not on PATH" >&2; exit 2; }
docker info >/dev/null 2>&1 || { echo "offline-check: the docker daemon is not running" >&2; exit 2; }

name=$(basename "$(cd "$dir" && pwd)" | tr -cd '[:alnum:]_.-')
tag="offline-check:${name:-build}-$$"
trap 'docker image rm -f "$tag" >/dev/null 2>&1 || true' EXIT

echo "== build (no network)"
docker build --network none -t "$tag" "$dir"

echo "== run (no network): ${cmd[*]}"
docker run --rm --network none "$tag" "${cmd[@]}"
