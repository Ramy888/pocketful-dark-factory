#!/usr/bin/env bash
# Runtime wrapper for factory seats on OpenCode, the sibling of claude-seat and codex-seat.
# Usage: opencode-seat <role> [opencode args...]      e.g. opencode-seat verifier acp
#
# Two jobs.
#
# 1. Isolation. OpenCode loads the operator's ~/.claude/CLAUDE.md into every session. A seat
#    that inherits a personal working agreement is not running on its mandate, and in a judged
#    run that agreement sits in the room competing for the seat's attention. The config key
#    `instructions` only ADDS files, so the only reliable suppression is a HOME of its own.
#
# 2. One model per seat. The transport that lets Band own an OpenCode runtime does not accept
#    a model selector, so the model has to come from configuration — which means a separate
#    config directory per role, not one shared file. Each is generated here from seats.conf,
#    so a seat's model still has exactly one source.
#
# The provider block is read from the operator's own opencode config, so the credential stays
# wherever they keep it and is never copied into a repository.
set -eu

repo=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
role="${1:?usage: opencode-seat <role> [opencode args...]}"
shift || true

: "${FACTORY_OPENCODE_HOME:=$HOME/.opencode-factory}"
: "${OPERATOR_OPENCODE_CONFIG:=${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json}"

model=$(grep -v '^[[:space:]]*#' "$repo/factory/seats.conf" \
        | awk -F'|' -v r="$role" '$1==r {print $3; exit}')
[ -n "$model" ] || { echo "opencode-seat: '$role' has no row in factory/seats.conf" >&2; exit 1; }
[ -f "$OPERATOR_OPENCODE_CONFIG" ] || {
  echo "opencode-seat: no provider config at $OPERATOR_OPENCODE_CONFIG" >&2; exit 1; }

seat_home="$FACTORY_OPENCODE_HOME/$role"
seat_config="$seat_home/.config/opencode"
mkdir -p "$seat_config"

# Regenerated every start: the operator's provider block, plus this seat's default model.
python3 - "$OPERATOR_OPENCODE_CONFIG" "$seat_config/opencode.json" "$model" <<'PY'
import json, sys
src, dst, model = sys.argv[1], sys.argv[2], sys.argv[3]
cfg = json.load(open(src))
provider = cfg.get("provider", {})
# seats.conf names the bare model; find the provider block that declares it.
owner = next((p for p, v in provider.items() if model in (v.get("models") or {})), None)
if owner is None:
    sys.exit(f"opencode-seat: no provider in {src} declares model {model!r}")
out = {"$schema": cfg.get("$schema", "https://opencode.ai/config.json"),
       "provider": provider, "model": f"{owner}/{model}"}
json.dump(out, open(dst, "w"), indent=2)
print(f"seat {dst}: model {owner}/{model}", file=sys.stderr)
PY
chmod 600 "$seat_config/opencode.json"

if [ -f "$seat_home/.claude/CLAUDE.md" ]; then
  echo "opencode-seat: $seat_home/.claude/CLAUDE.md exists and would be inherited" >&2
  exit 1
fi

HOME="$seat_home" XDG_CONFIG_HOME="$seat_home/.config" exec opencode "$@"
