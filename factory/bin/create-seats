#!/usr/bin/env bash
# Create the factory's seats. Each gets its own git worktree, its own git identity, and its
# mandate as a live-linked owner-instructions file. Which harness and model a seat runs is
# read from factory/seats.conf, never hardcoded here.
# Usage: factory/bin/create-seats [role...]   (default: every mandate in factory/mandates)
# Env:   RESULT_REPO  the repository the seats commit their work to. Mandates always come
#                     from this factory; only the work goes there. Default: this factory's
#                     own repository, which is what you want while rehearsing. Point it at
#                     the deliverable's repository for a real run, and keep the two apart —
#                     a reader judging the work should see the band's commits, not the
#                     factory's development history.
#        SEAT_ROOT    worktree parent (default: <result repo>-seats beside that repository)
#        SEAT_PREFIX  session prefix, one scope per seat (default: factory). Jam has no
#                     command to delete or re-point an agent, and creating one again on a
#                     session that already has a seat is undefined, so a run that needs
#                     seats in a different working copy gets its own prefix instead of
#                     overwriting the seats a previous run configured.
#        CODEX_EFFORT reasoning effort for a Codex-harness seat (default: high)
#        SKIP_JAM     prepare the worktrees and seat identities but create no agents.
#                     Creating an agent is permanent — Jam has no command to delete one —
#                     so rebuilding a working copy for a second run uses this rather than
#                     minting a third set of seats. Also how this script is tested.
set -euo pipefail

repo=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)

# Where the work lands. A worktree needs a commit to branch from, so an empty repository
# is refused here rather than half-way through creating the seats.
work_repo=$(git -C "${RESULT_REPO:-$repo}" rev-parse --show-toplevel 2>/dev/null) || {
  echo "create-seats: RESULT_REPO '${RESULT_REPO:-$repo}' is not a git repository" >&2; exit 1; }
git -C "$work_repo" rev-parse --verify --quiet HEAD >/dev/null || {
  echo "create-seats: '$work_repo' has no commit yet, so a seat worktree cannot branch" >&2
  echo "             from it. Commit something there first, even just a README." >&2; exit 1; }

seat_root="${SEAT_ROOT:-$(dirname "$work_repo")/$(basename "$work_repo")-seats}"

# Per-worktree config is off by default, and without it every seat identity below lands in
# the one shared config file instead of its own worktree.
git -C "$work_repo" config extensions.worktreeConfig true

echo "work lands in: $work_repo"
if [[ "$work_repo" == "$repo" ]]; then
  echo "   (the factory's own repository — set RESULT_REPO for a real run)"
fi

description() {
  case "$1" in
    coordinator) echo "Plans the work, sequences it, keeps the decisions log and reports to the owner." ;;
    implementer) echo "Builds one work item at a time and hands off reproducible evidence." ;;
    verifier)    echo "Derives acceptance checks from the specification, reproduces every handoff, holds the veto." ;;
    *)           echo "Factory seat: $1." ;;
  esac
}

# Harness, model and runtime come from factory/seats.conf, which the mandates are tested
# against. Nothing here hardcodes a model: a mandate and its launcher cannot disagree.
seats_conf="$repo/factory/seats.conf"
row() { grep -v '^[[:space:]]*#' "$seats_conf" | awk -F'|' -v r="$1" '$1==r {print; exit}'; }
field() { row "$1" | cut -d'|' -f"$2"; }
harness() { field "$1" 2; }
model()   { field "$1" 3; }
runtime() { field "$1" 4; }


if [[ $# -eq 0 ]]; then
  for m in "$repo"/factory/mandates/*.md; do set -- "$@" "$(basename "$m" .md)"; done
fi

for role in "$@"; do
  mandate="$repo/factory/mandates/$role.md"
  [[ -f "$mandate" ]] || { echo "create-seats: no mandate for '$role'" >&2; exit 1; }

  worktree="$seat_root/$role"
  if [[ ! -d "$worktree" ]]; then
    if git -C "$work_repo" show-ref --verify --quiet "refs/heads/seat/$role"; then
      git -C "$work_repo" worktree add "$worktree" "seat/$role"
    else
      git -C "$work_repo" worktree add -b "seat/$role" "$worktree" HEAD
    fi
  fi

  # A seat commits as itself, so the history shows which seat produced which change.
  # Sharing one identity makes every commit look like the owner's, which is the opposite
  # of the evidence a reader needs.
  #
  # `--worktree` is not optional here. Linked worktrees share one config file, so a plain
  # `git -C "$worktree" config user.name` writes to the repository, and the last seat in
  # this loop would rename every other seat and the owner along with them.
  git -C "$worktree" config --worktree user.name "$role"
  git -C "$worktree" config --worktree user.email "$role@${SEAT_EMAIL_DOMAIN:-factory.test}"

  seat_harness=$(harness "$role"); seat_model=$(model "$role"); seat_runtime=$(runtime "$role")
  if [[ -z "$seat_harness" ]]; then
    echo "create-seats: '$role' has no row in factory/seats.conf" >&2; exit 1
  fi
  echo "== $role ($seat_harness $seat_model) in $worktree"

  # Band owns a runtime only for the harnesses it has a transport for. Anything else is a
  # process this machine runs and attaches, so creating a Band agent here would make a seat
  # with nothing behind it.
  if [[ "$seat_runtime" != "jam" ]]; then
    echo "   worktree and identity ready. This harness has no Band-owned transport, so start"
    echo "   it yourself:  factory/bin/run-seat $role"
    continue
  fi

  case "$seat_harness" in
    Codex)    runtime=(--transport codex-app-server --spawn-command "$repo/factory/bin/codex-seat"
                       --runtime-model "$seat_model" --runtime-effort "${CODEX_EFFORT:-high}") ;;
    # ACP takes no model selector, so the seat's wrapper carries the model instead: it
    # generates a config directory per role from seats.conf. Passing --runtime-model here
    # is rejected by the transport before anything is even spawned.
    OpenCode) runtime=(--transport acp --spawn-command "$repo/factory/bin/opencode-seat"
                       --spawn-arg "$role" --spawn-arg acp) ;;
    *)        runtime=(--transport claude-code-cli --spawn-command "$repo/factory/bin/claude-seat"
                       --runtime-model "$seat_model") ;;
  esac
  if [[ -n "${SKIP_JAM:-}" ]]; then
    echo "   worktree and identity ready; no agent created (SKIP_JAM)"
    continue
  fi

  jam agent create --json \
    --session "${SEAT_PREFIX:-factory}-$role" \
    "${runtime[@]}" \
    --name "$role" \
    --description "$(description "$role")" \
    --cwd "$worktree" \
    --instructions-file "$mandate"
done
